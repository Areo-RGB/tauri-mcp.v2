{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MCPHub Frontend",
  "version": "1.1.1",
  "identifier": "com.mcphub.frontend",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://127.0.0.1:5174",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/icon.ico"
    ]
  }
}
