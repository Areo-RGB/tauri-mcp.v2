{
  "name": "mcphub-electron",
  "private": true,
  "version": "1.1.1",
  "type": "module",
  "packageManager": "pnpm@10.12.4",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently --kill-others-on-fail \"vite\" \"wait-on tcp:127.0.0.1:5174 && electron .\"",
    "frontend:dev": "vite",
    "build": "vite build",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "test": "node --test electron/services/*.test.cjs",
    "electron": "electron .",
    "electron:dev": "pnpm dev",
    "electron:build": "pnpm build && electron-builder --win portable",
    "electron:build:dir": "pnpm build && electron-builder --dir"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "clsx": "^2.1.1",
    "lucide-svelte": "^0.552.0",
    "shadcn-svelte": "^1.4.2",
    "svelte": "^5.39.0",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@internationalized/date": "^3.12.2",
    "@lucide/svelte": "^1.27.0",
    "@sveltejs/vite-plugin-svelte": "^6.2.0",
    "@tailwindcss/vite": "^4.3.0",
    "bits-ui": "^2.18.1",
    "concurrently": "^9.2.1",
    "electron": "^37.3.1",
    "electron-builder": "^26.0.12",
    "svelte-check": "^4.3.2",
    "tailwind-variants": "^3.3.0",
    "tailwindcss": "^4.3.0",
    "typescript": "^5.9.3",
    "vite": "^6.4.3",
    "wait-on": "^8.0.4"
  },
  "build": {
    "appId": "com.mcphub.frontend",
    "productName": "MCPHub Frontend",
    "asar": true,
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "extensions",
        "to": "extensions"
      }
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": ["x64"]
        }
      ],
      "artifactName": "MCPHub-Frontend.${ext}"
    }
  }
}
